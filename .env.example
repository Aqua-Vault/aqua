# Aqua Frontend Environment Variables
# Copy this to .env.local and fill in your deployed contract addresses

# Network (testnet or mainnet)
NEXT_PUBLIC_NETWORK=testnet

# Contract addresses (from scripts/deploy.sh output)
NEXT_PUBLIC_VAULT_ID=
NEXT_PUBLIC_POOL_ID=
NEXT_PUBLIC_USDC_ID=

# Optional: Stellar Expert base URL for transaction links
NEXT_PUBLIC_STELLAR_EXPERT_URL=https://stellar.expert/explorer/testnet
